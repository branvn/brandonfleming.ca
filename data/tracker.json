    {
      "id": "1f5c994a7759",
      "title": "R149: Inclusionary Housing in Select Transit-Oriented Areas (Phased Implementation)",
      "url": "https://www.surrey.ca/sites/default/files/corporate-reports/CR_2026-R149.pdf",
      "date": "2026-07-13",
      "hits": 98,
      "matched": [
        "transit-oriented area",
        "transit oriented area",
        "inclusionary"
      ],
      "source": "City of Surrey: Corporate Reports",
      "jurisdiction": "Surrey",
      "type": "council",
      "note": "Surrey's framework for inclusionary zoning in transit-oriented areas, required to meet its $100.7 million Housing Accelerator Fund commitment to draft an inclusionary zoning bylaw by 30 September 2026. It amends Zoning Bylaw 12000 and creates Inclusionary Affordable Housing Reserve Fund Bylaw 22093, but phases implementation so the inclusionary requirements themselves are deferred in the near term, balancing the city's affordability objectives against current economic and development conditions. The deadline gets met; the requirements wait."
    },
